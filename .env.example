# Copy the required settings into .env and replace every placeholder.
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
# SECRET_KEY=<random-secret-at-least-32-characters>
# Set the same password used by Docker Compose's REDIS_PASSWORD.
REDIS_PASSWORD=<random-redis-password>
# Optional: set REDIS_URL only when using a non-default host/database or managed Redis.
# If the URL has no password, REDIS_PASSWORD is added automatically.
# REDIS_URL=redis://localhost:6379/0
# Set this to the exact frontend origin in production, e.g. https://<your-hostname>.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://<your-hostname>
